	sh:targetClass tmodel:Vulnerability .
tmodel:Weakness a sh:NodeShape ;
	rdfs:comment "Generic weakness, catalogued as CWE (§1 layer 3). The CWE↔CAPEC link is a human-reviewed mapping (an Assertion), not a facet property (§2) — no hard edge to AttackPattern in this cut." ;
