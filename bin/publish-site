#!/usr/bin/env bash
# publish-site — rebuild every generated page under docs/ from its manifest.
# Site map and which manifest owns which path: docs/publishing/site.yaml.
# Record pages are built in the library submodule beside their source and
# copied; the pin decides which library version is published.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -f library/bin/_record_html.py ] || {
  echo "library submodule missing bin/_record_html.py — git submodule update --init" >&2; exit 1; }
python3 docs/publishing/render_report.py
# The TARA pages read the example models through the engine, which needs PyYAML:
# the engine's environment (CONTRIBUTING §10) when it exists, else python3.
tara_py=python3
[ -x engine/.venv/bin/python ] && tara_py=engine/.venv/bin/python
"$tara_py" docs/publishing/render_tara.py
"$tara_py" docs/publishing/render_sdl.py   # tmodel SDL page (DL-0040)
python3 docs/publishing/render_bibliography.py
# Example-model pages (#208): the engine collects each model, which needs PyYAML
# (the engine's environment, CONTRIBUTING §10, when it exists, else python3), and
# the app's own report renderer writes the HTML through Node 22.6 or newer.
models_py=python3
[ -x engine/.venv/bin/python ] && models_py=engine/.venv/bin/python
"$models_py" docs/publishing/render_models.py
"$models_py" docs/publishing/render_app.py
python3 docs/publishing/check_identities.py
python3 docs/publishing/check_links.py
