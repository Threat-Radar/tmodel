#!/usr/bin/env python3
"""fetch-pdfs: rebuild a local PDF cache from a manifest. PDFs are never committed.

usage: bin/fetch-pdfs [manifest] [cache_dir]
  manifest   default research/0014-ai-threat-model/pdf-manifest.tsv
  cache_dir  default $TMODEL_PDF_CACHE or ~/tmodel-pdf-cache/ai-threat-model
Skips files already present with the right sha256. A changed sha256 means the
publisher re-issued the file. That is reported, not fatal; the new file is kept.
"""
import hashlib, os, pathlib, subprocess, sys, time

man = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "research/0014-ai-threat-model/pdf-manifest.tsv")
cache = pathlib.Path(os.path.expanduser(sys.argv[2] if len(sys.argv) > 2 else
        os.environ.get("TMODEL_PDF_CACHE", "~/tmodel-pdf-cache/ai-threat-model")))
cache.mkdir(parents=True, exist_ok=True)
ok = got = changed = failed = 0
for line in man.read_text().splitlines():
    if not line.strip() or line.startswith("#"):
        continue
    fn, sha, sid, url = (line.split("\t") + [""] * 4)[:4]
    dst = cache / fn
    if dst.exists() and hashlib.sha256(dst.read_bytes()).hexdigest() == sha:
        ok += 1; continue
    if not url:
        print(f"NO-URL   {fn} ({sid}): fetch by hand"); failed += 1; continue
    r = subprocess.run(["curl", "-sSL", "-m", "180", "-A", "Mozilla/5.0", "-o", str(dst), url])
    if r.returncode or not dst.exists() or not dst.read_bytes().startswith(b"%PDF"):
        print(f"FAILED   {fn} <- {url}"); dst.unlink(missing_ok=True); failed += 1
    elif hashlib.sha256(dst.read_bytes()).hexdigest() != sha:
        print(f"CHANGED  {fn}: sha256 differs from manifest (publisher re-issued?)"); changed += 1
    else:
        got += 1
    time.sleep(2 if "arxiv.org" in url else 0.5)
print(f"cache {cache}: {ok} present, {got} fetched, {changed} changed, {failed} failed")
