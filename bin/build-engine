#!/usr/bin/env bash
# build-engine: build the Python engine as one standalone executable (PyInstaller)
# and put it where Tauri bundles sidecars (#124). The app then needs no Python.
#
#   bin/build-engine            build for this machine
#
# Output: apps/desktop/src-tauri/binaries/tmodel-engine-<target triple>
# (Tauri's externalBin naming). Needs python3 (3.11+) and rustc (for the triple);
# PYTHON overrides the interpreter, TARGET_TRIPLE the triple.
set -euo pipefail
cd "$(dirname "$0")/.."

PY="${PYTHON:-python3}"
TRIPLE="${TARGET_TRIPLE:-$(rustc -vV | sed -n 's/^host: //p')}"
BUILD="engine/build/sidecar"
OUT="apps/desktop/src-tauri/binaries"
NAME="tmodel-engine-$TRIPLE"

rm -rf "$BUILD"
"$PY" -m venv "$BUILD/venv"
VPY="$BUILD/venv/bin/python"
"$VPY" -m pip install --quiet --upgrade pip
"$VPY" -m pip install --quiet ./engine -r engine/packaging/requirements.txt

# The Library tab serves the pinned library (#259). A packaged engine has no repo
# around it, so bundle the files the loader reads (its RECORD_GLOB and NOTED_GLOBS:
# record.yaml, summary.md and old versions). Distilled source text stays out, so no
# licensed wording ships in the app.
LIB="$BUILD/library"
"$VPY" - "$LIB" <<'PY'
import shutil
import sys
from pathlib import Path

from engine.load.library import NOTED_GLOBS, RECORD_GLOB

source, target = Path("library"), Path(sys.argv[1])
if not any(source.glob(RECORD_GLOB)):
    sys.exit("build-engine: no library records in library/; run: git submodule update --init library")
files = sorted({path for pattern in (RECORD_GLOB, *NOTED_GLOBS) for path in source.glob(pattern)})
for path in files:
    copy = target / path.relative_to(source)
    copy.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, copy)
print(f"bundling {len(files)} library files")
PY

# The CWE release the library pins (ADR-0014): download it, refuse it unless its SHA-256
# matches the pin, and bundle it, so the Weaknesses tab works in the app. A copy that
# $TMODEL_CWE_CATALOG names is used instead of the download; it must match the pin too.
CAT="$BUILD/catalogs"
"$VPY" - "$CAT" <<'PY'
import hashlib
import os
import sys
import time
import urllib.request
from pathlib import Path

from engine.load.cwe import CATALOG_ENV, LIBRARY_RECORD, bundled_name
from engine.load.library import load_library
from engine.load.cwe import MAX_FILE_BYTES  # the engine refuses a larger catalog file; so does the build

record = load_library(Path("library")).get(LIBRARY_RECORD)
if record is None or not record.content.url or not record.content.sha256:
    sys.exit("build-engine: the library pins no CWE release (its cwe record has no url or sha256)")
url, pinned = record.content.url, record.content.sha256.strip().lower()
local = os.environ.get(CATALOG_ENV, "").strip()
if local:
    path = Path(os.path.expanduser(local))
    if path.stat().st_size > MAX_FILE_BYTES:
        sys.exit(f"build-engine: {path} is larger than {MAX_FILE_BYTES} bytes")
    data = path.read_bytes()
else:
    for attempt in range(3):
        try:
            request = urllib.request.Request(url, headers={"User-Agent": "tmodel-build"})
            with urllib.request.urlopen(request, timeout=60) as response:
                chunks, size = [], 0
                while chunk := response.read(1 << 20):  # streamed: an oversized file stops early
                    size += len(chunk)
                    if size > MAX_FILE_BYTES:
                        sys.exit(f"build-engine: {url} is larger than {MAX_FILE_BYTES} bytes")
                    chunks.append(chunk)
            data = b"".join(chunks)
            break
        except OSError as exc:
            if attempt == 2:
                sys.exit(f"build-engine: could not download {url}: {exc}")
            time.sleep(5)
digest = hashlib.sha256(data).hexdigest()
if digest != pinned:
    sys.exit(f"build-engine: {url} has SHA-256 {digest}, but the library pins {pinned}")
target = Path(sys.argv[1]) / bundled_name(url)
target.parent.mkdir(parents=True, exist_ok=True)
target.write_bytes(data)
print(f"bundling {target.name} ({len(data)} bytes, SHA-256 {pinned[:12]})")
PY

"$VPY" -m PyInstaller --onefile --clean --noconfirm --log-level WARN \
  --name "$NAME" \
  --add-data "$PWD/spec/vectors:spec/vectors" \
  --add-data "$PWD/spec/schema/tmodel-object-model.linkml.yaml:spec/schema" \
  --add-data "$PWD/spec/MAP-0001.yaml:spec" \
  --add-data "$PWD/$LIB:library" \
  --add-data "$PWD/$CAT:catalogs" \
  --distpath "$OUT" --workpath "$BUILD/work" --specpath "$BUILD" \
  engine/packaging/tmodel_engine.py

# Smoke test: the executable runs the engine with no Python on the path.
env -i HOME="$HOME" "$OUT/$NAME" version --in-process --json
env -i HOME="$HOME" "$OUT/$NAME" paths \
  "$PWD/spec/vectors/mvp-01-software-doc-service.yaml" \
  --goal threat-instance:imds-pivot --in-process --json
env -i HOME="$HOME" "$OUT/$NAME" sdl sdl-01-tmodel-desktop.yaml --in-process --json >/dev/null
# The bundled library loads with no checkout and no TMODEL_LIBRARY (exits 1 on a bad record).
env -i HOME="$HOME" "$OUT/$NAME" library --in-process --json \
  | "$VPY" -c 'import json, sys; n = json.load(sys.stdin)["library"]["count"]; assert n, "bundled library is empty"; print(f"bundled library: {n} records")'
# The bundled CWE release loads with no TMODEL_CWE_CATALOG (ADR-0014).
env -i HOME="$HOME" "$OUT/$NAME" weaknesses --limit 1 --in-process --json \
  | "$VPY" -c 'import json, sys; n = json.load(sys.stdin)["total"]; assert n, "bundled CWE release is empty"; print(f"bundled CWE release: {n} entries")'
# Project saves check the schema with no LinkML: the containers and the object model
# they import load from the bundle (#288, DL-0081). The engine stops when stdin closes.
SERVED=$(env -i HOME="$HOME" TMODEL_HOST_TOKEN="$("$VPY" -c 'import secrets; print(secrets.token_urlsafe(32))')" \
  "$OUT/$NAME" serve --projects --port 0 --exit-with-parent </dev/null)
grep -q "project folders: on" <<<"$SERVED" || { echo "project folders do not start" >&2; exit 1; }
echo "built $OUT/$NAME"
