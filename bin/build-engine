#!/usr/bin/env bash
# build-engine: build the Python engine as one standalone executable (PyInstaller)
# and put it where Tauri bundles sidecars (#124). The app then needs no Python.
#
#   bin/build-engine            build for this machine
#
# Output: apps/desktop/src-tauri/binaries/tmodel-engine-<target triple>
# (Tauri's externalBin naming). Needs python3 (3.11+) and rustc (for the triple);
# PYTHON overrides the interpreter, TARGET_TRIPLE the triple.
set -euo pipefail
cd "$(dirname "$0")/.."

PY="${PYTHON:-python3}"
TRIPLE="${TARGET_TRIPLE:-$(rustc -vV | sed -n 's/^host: //p')}"
BUILD="engine/build/sidecar"
OUT="apps/desktop/src-tauri/binaries"
NAME="tmodel-engine-$TRIPLE"

rm -rf "$BUILD"
"$PY" -m venv "$BUILD/venv"
VPY="$BUILD/venv/bin/python"
"$VPY" -m pip install --quiet --upgrade pip
"$VPY" -m pip install --quiet ./engine -r engine/packaging/requirements.txt

# The Library tab serves the pinned library (#259). A packaged engine has no repo
# around it, so bundle the files the loader reads (its RECORD_GLOB and NOTED_GLOBS:
# record.yaml, summary.md and old versions). Distilled source text stays out, so no
# licensed wording ships in the app.
LIB="$BUILD/library"
"$VPY" - "$LIB" <<'PY'
import shutil
import sys
from pathlib import Path

from engine.load.library import NOTED_GLOBS, RECORD_GLOB

source, target = Path("library"), Path(sys.argv[1])
if not any(source.glob(RECORD_GLOB)):
    sys.exit("build-engine: no library records in library/; run: git submodule update --init library")
files = sorted({path for pattern in (RECORD_GLOB, *NOTED_GLOBS) for path in source.glob(pattern)})
for path in files:
    copy = target / path.relative_to(source)
    copy.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, copy)
print(f"bundling {len(files)} library files")
PY

"$VPY" -m PyInstaller --onefile --clean --noconfirm --log-level WARN \
  --name "$NAME" \
  --add-data "$PWD/spec/vectors:spec/vectors" \
  --add-data "$PWD/spec/MAP-0001.yaml:spec" \
  --add-data "$PWD/$LIB:library" \
  --distpath "$OUT" --workpath "$BUILD/work" --specpath "$BUILD" \
  engine/packaging/tmodel_engine.py

# Smoke test: the executable runs the engine with no Python on the path.
env -i HOME="$HOME" "$OUT/$NAME" version --in-process --json
env -i HOME="$HOME" "$OUT/$NAME" paths \
  "$PWD/spec/vectors/mvp-01-software-doc-service.yaml" \
  --goal threat-instance:imds-pivot --in-process --json
env -i HOME="$HOME" "$OUT/$NAME" sdl sdl-01-tmodel-desktop.yaml --in-process --json >/dev/null
# The bundled library loads with no checkout and no TMODEL_LIBRARY (exits 1 on a bad record).
env -i HOME="$HOME" "$OUT/$NAME" library --in-process --json \
  | "$VPY" -c 'import json, sys; n = json.load(sys.stdin)["library"]["count"]; assert n, "bundled library is empty"; print(f"bundled library: {n} records")'
echo "built $OUT/$NAME"
