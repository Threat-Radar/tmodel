      "properties": {
        "description": "The instance the attack runs against; no build identity is published for it."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:headlight-ecu",
      "label": "Light-control ECU",
      "properties": {
        "component_kind": "device",
        "description": "Controls the headlights; its connector, behind the bumper, is the easiest reach into the control CAN bus."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:smart-key-ecu",
      "label": "Smart-key receiver ECU",
      "properties": {
        "component_kind": "device",
        "description": "Talks to the key by radio and announces on the control CAN bus when the key is validated."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:door-ecu",
      "label": "Door ECU",
      "properties": {
        "component_kind": "device",
        "description": "Unlocks the doors on a valid key message."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:gateway-ecu",
      "label": "Gateway ECU",
      "properties": {
        "component_kind": "device",
        "description": "Copies certain CAN messages between the control and powertrain buses."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:engine-ecu",
      "label": "Engine control ECU",
      "properties": {
        "component_kind": "device",
        "description": "Deactivates the immobilizer when it sees a key-validated message."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:control-can",
      "label": "Control CAN bus",
      "properties": {
        "component_kind": "interconnect",
        "description": "Joins the headlight, door, telematics and smart-key ECUs."
      }
    },
    {
      "domain_type": "Component",
      "id": "component:powertrain-can",
      "label": "Powertrain CAN bus",
      "properties": {
        "component_kind": "interconnect",
        "description": "Joins engine, hybrid battery and motor control."
      }
    },
    {
      "domain_type": "Weakness",
      "id": "weakness:cwe-74",
      "label": "Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')",
      "properties": {
        "catalog_ref": "CWE-74",
        "description": "The CWE CISA-ADP assigned to CVE-2023-29389 (the CNA gave none)."
      }
    },
    {
      "domain_type": "Vulnerability",
      "id": "vulnerability:cve-2023-29389",
      "label": "RAV4 2021 ECUs trust forged \"Key is validated\" CAN messages",
      "properties": {
        "catalog_ref": "CVE-2023-29389",
        "description": "CVE record, paraphrased: Toyota RAV4 2021 vehicles trust messages from other ECUs on a CAN bus, so a physically present attacker who reaches the control CAN bus at the headlight connector can send forged \"Key is validated\" messages and drive away."
      }
    },
    {
      "domain_type": "ThreatInstance",
      "id": "threat-instance:spoofed-key-validated",
      "label": "Spoofed \"key validated\" frames injected on the control CAN bus",
      "properties": {
        "description": "A device on the control bus impersonates the smart-key ECU; the gateway forwards its frames and the engine ECU deactivates the immobilizer.",
        "method_facet": [
